  "add_scripts": [
    {
      "target": "etc/init.d/S91audiobook_resume.sh",
      "mode": "0755",
      "description": "Boot script for audiobook resume daemon (generated with feature flags substituted)",
      "source_type": "build_firmware_overlay.py",
      "template": "RESUME_BOOT_SCRIPT"
    },
    {
      "target": "etc/init.d/S92audiobook_db_maint.sh",
      "mode": "0755",
      "description": "Boot script for audiobook DB maintenance watcher (generated with feature flags substituted)",
      "source_type": "build_firmware_overlay.py",
      "template": "DB_MAINT_BOOT_SCRIPT"
    },
    {
      "target": "etc/init.d/S90adb",
      "mode": "0755",
      "description": "Boot script for persistent ADB (conditional on --enable-boot-adb)",
      "source_type": "build_firmware_overlay.py",
      "template": "ADB_BOOT_SCRIPT",
      "conditional": "enable_boot_adb"
    }
  ],

  "add_generated": [
    {
      "target": "etc/r1_audiobook_version",
      "mode": "0644",
      "description": "Firmware version marker file (generated from build options)",
      "source_type": "build_firmware_overlay.py",
      "template": "VERSION_MARKER"
    },
    {
      "target": "etc/ota_info",
      "mode": "0644",
      "description": "OTA info file (modified from stock when --ota-version or --ota-site is set)",
      "source_type": "build_firmware_overlay.py",
      "template": "OTA_INFO",
      "conditional": "ota_version_nonzero_or_ota_site"
    }
  ],

  "patch_binary": [
    {
      "target": "usr/bin/hiby_player",
      "tool": "patch_hiby_player.py",
      "description": "Apply guarded byte patches to the stock hiby_player binary",
      "flags": [
        "--scan-skip",
        "--book-audio-shim",
        "--audiobook-launcher-genre",
        "--audiobook-private-direct-route",
        "--audiobook-native-hub-title-row",
        "--audiobook-native-hub-launcher",
        "--audiobook-native-hub-folder-rows",
        "--audiobook-native-hub-view-rows",
        "--audiobook-title-autostart-marker",
        "--select-dispatch-branch"
      ]
    }
  ],

  "patch_resources": [
    {
      "target": "usr/resource/str",
      "tool": "patch_r1_resource_text.py",
      "description": "Patch resource string INI files (about_dev.ini, book.ini, songlist.ini, launcher.ini) and config.json product version",
      "flags": [
        "--about-model",
        "--product-version",
        "--audiobook-native-hub-labels",
        "--audiobook-native-hub-view-labels"
      ]
    },
    {
      "target": "usr/resource/litegui",
      "tool": "generate_audiobook_launcher_icons.py",
      "description": "Generate audiobook launcher icons replacing stock book icons",
      "conditional": "include_audiobook_launcher_icon"
    }
  ],

  "patch_audio_unlocks": [
    {
      "target": "usr/resource/ot_devices.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--native-dsd",
      "description": "Unlock native DSD playback for analog output",
      "conditional": "unlock_native_dsd"
    },
    {
      "target": "usr/resource/set_functions.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/resource/midi_set_functions.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings (midi set)",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/resource/config.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings (config dac_to_store)",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/bin/bt_init",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--sbc-xq",
      "description": "Enable Bluetooth SBC-XQ codec quality",
      "conditional": "enable_bluetooth_sbc_xq"
    }
  ],

  "patch_text": [
    {
      "target": "usr/bin/hiby_player.sh",
      "description": "Remove batd SD logger from hiby_player.sh launch script",
      "conditional": "disable_batd_logger",
      "operation": "remove_batd_block"
    }
  ],

  "mode_overrides": [
    {"target": "etc/init.d/S90adb", "mode": "0755", "conditional": "enable_boot_adb"},
    {"target": "etc/init.d/S91audiobook_resume.sh", "mode": "0755"},
    {"target": "etc/init.d/S92audiobook_db_maint.sh", "mode": "0755"},
    {"target": "etc/r1_audiobook_version", "mode": "0644"},

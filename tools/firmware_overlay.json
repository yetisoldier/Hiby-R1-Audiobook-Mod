    {"target": "usr/bin/r1_audiobook_direct_open", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon_shell.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_db_maint", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_db_watch.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_refresh.sh", "mode": "0755"},
    {"target": "usr/bin/r1_usrlocal_media_seed.db", "mode": "0644"},
    {"target": "usr/bin/r1_touch_next_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_first_track_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_first_track_down_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_first_track_move_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_first_track_up_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_back_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_row1_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_row2_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_row3_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_row4_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_row5_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_down_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move1_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move2_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move3_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move4_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move5_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_move6_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_touch_track_swipe_up_event1.bin", "mode": "0644"},
    {"target": "usr/bin/r1_key_next_event0.bin", "mode": "0644"},
    {"target": "usr/bin/r1_key_prev_event2.bin", "mode": "0644"},
    {"target": "usr/bin/r1_audiobook_catalog.tsv", "mode": "0644"}
  ],

  "squashfs_options": {
    "compression": "lzo",
    "block_size": "131072",
    "all_root": true,
    "pseudo_file": true
  },

  "upt_options": {
    "tool": "build_r1_upt.py",
    "requires": ["xImage", "rootfs.squashfs"],
    "chunk_size": "512K"
  }
}

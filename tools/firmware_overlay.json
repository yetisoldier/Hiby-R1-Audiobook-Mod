{
  "_comment": "Overlay manifest for HiBy R1 Audiobook Firmware Mod. Lists all files the mod adds, patches, or removes from the stock rootfs. Applied by build_firmware_overlay.py against a stock rootfs.squashfs.",
  "_format": "Each entry has: source (where the file comes from), target (rootfs-relative path), mode (octal permissions), and type (copy | script | generated | patch-binary | patch-resource | patch-text | remove | touch-event). Script entries contain inline shell script text. Generated entries are produced by helper scripts at build time.",

  "metadata": {
    "name": "hiby-r1-audiobook-mod",
    "base_firmware": "1.6",
    "default_version_id": "1.6.16.5-audiobook",
    "default_version_label": "HiBy R1 Audiobook FW 1.6.16.5"
  },

  "add_files": [
    {
      "target": "usr/share/audiobooks/fonts/msyh.ttf",
      "source": "app/assets/msyh.ttf",
      "mode": "0644",
      "description": "Chinese fallback font for stb_truetype UI"
    },
    {
      "target": "usr/share/audiobooks/hiby-theme",
      "source_type": "directory",
      "source": "app/assets/hiby-theme",
      "mode": "0644",
      "description": "HiBy theme PNG assets for the audiobook UI"
    },
    {
      "target": "usr/bin/r1_audiobook_app",
      "source": "build/r1_audiobook_app",
      "mode": "0755",
      "description": "Standalone audiobook application"
    },
    {
      "target": "usr/bin/r1_audiobook_launch.sh",
      "source": "tools/r1_audiobook_launch.sh",
      "mode": "0755",
      "description": "Launcher wrapper for the Audiobooks tile"
    },
    {
      "target": "usr/bin/r1_audiobook_resume_daemon",
      "source": "build/r1_audiobook_resume_daemon",
      "mode": "0755",
      "description": "Compiled MIPS audiobook resume daemon (lifecycle/IPC bridge only)"
    },
    {
      "target": "usr/bin/r1_audiobook_resume_daemon.sh",
      "source": "tools/r1_audiobook_resume_daemon_wrapper.sh",
      "mode": "0755",
      "description": "Wrapper that prefers the compiled resume daemon binary"
    },
    {
      "target": "usr/bin/r1_audiobook_resume_daemon_shell.sh",
      "source": "tools/r1_audiobook_resume_daemon.sh",
      "mode": "0755",
      "description": "Shell fallback resume daemon"
    },
    {
      "target": "usr/bin/r1_audiobook_db_maint",
      "source": "work/native-db-maint/r1_audiobook_db_maint",
      "mode": "0755",
      "description": "Native MIPS audiobook database maintenance helper"
    },
    {
      "target": "usr/bin/r1_audiobook_db_watch.sh",
      "source": "tools/r1_audiobook_db_watch.sh",
      "mode": "0755",
      "description": "Database watcher shell script"
    }
  ],

  "add_scripts": [
    {
      "target": "etc/init.d/S91audiobook_resume.sh",
      "mode": "0755",
      "description": "Boot script for audiobook resume daemon (generated with feature flags substituted)",
      "source_type": "build_firmware_overlay.py",
      "template": "RESUME_BOOT_SCRIPT"
    },
    {
      "target": "etc/init.d/S92audiobook_db_maint.sh",
      "mode": "0755",
      "description": "Boot script for audiobook DB maintenance watcher (generated with feature flags substituted)",
      "source_type": "build_firmware_overlay.py",
      "template": "DB_MAINT_BOOT_SCRIPT"
    },
    {
      "target": "etc/init.d/S90adb",
      "mode": "0755",
      "description": "Boot script for persistent ADB (conditional on --enable-boot-adb)",
      "source_type": "build_firmware_overlay.py",
      "template": "ADB_BOOT_SCRIPT",
      "conditional": "enable_boot_adb"
    }
  ],

  "add_generated": [
    {
      "target": "etc/r1_audiobook_version",
      "mode": "0644",
      "description": "Firmware version marker file (generated from build options)",
      "source_type": "build_firmware_overlay.py",
      "template": "VERSION_MARKER"
    },
    {
      "target": "etc/ota_info",
      "mode": "0644",
      "description": "OTA info file (modified from stock when --ota-version or --ota-site is set)",
      "source_type": "build_firmware_overlay.py",
      "template": "OTA_INFO",
      "conditional": "ota_version_nonzero_or_ota_site"
    }
  ],

  "patch_binary": [
    {
      "target": "usr/bin/hiby_player",
      "tool": "patch_hiby_player.py",
      "description": "Apply only the media-scanner audiobook skip patch to the stock hiby_player binary",
      "flags": [
        "--scan-skip"
      ]
    }
  ],

  "patch_resources": [
    {
      "target": "usr/resource/str",
      "tool": "patch_r1_resource_text.py",
      "description": "Patch resource string INI files (about_dev.ini, book.ini, songlist.ini, launcher.ini) and config.json product version",
      "flags": [
        "--about-model",
        "--product-version"
      ]
    },
    {
      "target": "usr/resource/litegui",
      "tool": "generate_audiobook_launcher_icons.py",
      "description": "Generate audiobook launcher icons replacing stock book icons",
      "conditional": "include_audiobook_launcher_icon"
    }
  ],

  "patch_audio_unlocks": [
    {
      "target": "usr/resource/ot_devices.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--native-dsd",
      "description": "Unlock native DSD playback for analog output",
      "conditional": "unlock_native_dsd"
    },
    {
      "target": "usr/resource/set_functions.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/resource/midi_set_functions.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings (midi set)",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/resource/config.json",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--usb-dac",
      "description": "Unlock USB DAC mode settings (config dac_to_store)",
      "conditional": "unlock_usb_dac_mode"
    },
    {
      "target": "usr/bin/bt_init",
      "tool": "patch_r1_audio_feature_unlocks.py",
      "flag": "--sbc-xq",
      "description": "Enable Bluetooth SBC-XQ codec quality",
      "conditional": "enable_bluetooth_sbc_xq"
    }
  ],

  "patch_text": [
    {
      "target": "usr/bin/hiby_player.sh",
      "description": "Remove batd SD logger from hiby_player.sh launch script",
      "conditional": "disable_batd_logger",
      "operation": "remove_batd_block"
    }
  ],

  "mode_overrides": [
    {"target": "etc/init.d/S90adb", "mode": "0755", "conditional": "enable_boot_adb"},
    {"target": "etc/init.d/S91audiobook_resume.sh", "mode": "0755"},
    {"target": "etc/init.d/S92audiobook_db_maint.sh", "mode": "0755"},
    {"target": "etc/r1_audiobook_version", "mode": "0644"},
    {"target": "usr/bin/r1_audiobook_app", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_launch.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_resume_daemon_shell.sh", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_db_maint", "mode": "0755"},
    {"target": "usr/bin/r1_audiobook_db_watch.sh", "mode": "0755"},
    {"target": "usr/share/audiobooks/fonts/msyh.ttf", "mode": "0644"},
    {"target": "usr/share/audiobooks/hiby-theme", "mode": "0644"}
  ],

  "squashfs_options": {
    "compression": "lzo",
    "block_size": "131072",
    "all_root": true,
    "pseudo_file": true
  },

  "upt_options": {
    "tool": "build_r1_upt.py",
    "requires": ["xImage", "rootfs.squashfs"],
    "chunk_size": "512K"
  }
}
